<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToPadding="false">

    <!-- Header Section -->
    <RelativeLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/widget_header_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WorkHub"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/app_title"
            android:text="Hey, Dharun!"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@mipmap/launcher_icon" />
    </RelativeLayout>

    <!-- Post Counts Row -->
    <LinearLayout
        android:id="@+id/counts_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_section"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Job Posts Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Jobs"
                android:textColor="#888DAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/job_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#003DEC"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Freelance Posts Card (Project Posts) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Freelance"
                android:textColor="#888DAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/freelance_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active Project Progress Section -->
    <LinearLayout
        android:id="@+id/progress_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/counts_row"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <TextView
                android:id="@+id/project_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE PROJECT"
                android:textColor="#888DAA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/project_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0%"
                android:textColor="#003DEC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/project_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No Active Project"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <ProgressBar
            android:id="@+id/project_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#003DEC" />
    </LinearLayout>

</RelativeLayout>
