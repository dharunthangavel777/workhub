# Firebase Cloud Functions Environment Variables
# 
# SECURITY NOTICE:
# - This file is a TEMPLATE only
# - NEVER commit actual credentials to version control
# - Copy this to .runtimeconfig.json for local development
# - Use Firebase CLI for production deployment

# Cashfree Payment Gateway Configuration
CASHFREE_APP_ID=YOUR_APP_ID
CASHFREE_SECRET_KEY=YOUR_SECRET_KEY
CASHFREE_API_VERSION=2022-09-01
CASHFREE_MODE=sandbox  # Use "production" for live environment

# Instructions:
# 
# For Local Development:
# 1. Copy this file to .runtimeconfig.json
# 2. Replace placeholder values with your actual Cashfree credentials
# 3. Format as JSON:
#    {
#      "cashfree": {
#        "app_id": "TEST107982915f5ddadfb46396b0016519289701",
#        "secret_key": "cfsk_ma_test_...",
#        "api_version": "2022-09-01",
#        "mode": "sandbox"
#      }
#    }
#
# For Production Deployment:
# Run these commands to set environment variables:
#
# firebase functions:config:set \
#   cashfree.app_id="YOUR_APP_ID" \
#   cashfree.secret_key="YOUR_SECRET_KEY" \
#   cashfree.api_version="2022-09-01" \
#   cashfree.mode="sandbox"
#
# Then deploy:
# firebase deploy --only functions
